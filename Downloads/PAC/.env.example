# ===========================================
# Think Tank Influence Tracker — Environment
# ===========================================
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local to version control.

# -------------------------------------------
# Supabase
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------
# Data APIs
# -------------------------------------------
# Federal Election Commission — https://api.open.fec.gov/
FEC_API_KEY=

# Senate Lobbying Disclosure Act — https://lda.senate.gov/api/
LDA_API_KEY=

# New York Times — https://developer.nytimes.com/
NYTIMES_API_KEY=
NYTIMES_SECRET=

# -------------------------------------------
# AI
# -------------------------------------------
# OpenRouter — https://openrouter.ai/
OPENROUTER_API_KEY=

# -------------------------------------------
# Optional
# -------------------------------------------
# Analytics domain (e.g., Plausible or similar)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Protect analysis API endpoints with a shared secret
# ANALYSIS_API_KEY=
