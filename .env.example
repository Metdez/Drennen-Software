# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter (all AI: session generation + analysis/profiles/briefs/reports)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional; defaults to deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Stripe (subscription billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id-here
STRIPE_PRICE_ANNUAL=price_your-annual-price-id-here

# Direct Postgres connection for analytics SQL agent
# Local dev (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production base URL (Stripe redirects); falls back to localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
