# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter (all AI: session generation + analysis/profiles/briefs/reports)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional; defaults to deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Direct Postgres connection for analytics SQL agent
# Local dev (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
